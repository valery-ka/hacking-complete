{
    "name": "hacking-complete",
    "version": "1.0.0",
    "description": "HaсK [C]omplete — open-source Babylon.js NieR:Automata hacking mini-game",
    "author": "valery-ka",
    "license": "MIT",
    "private": true,
    "homepage": "./",
    "main": "electron/main.js",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@babylonjs/core": "^8.55.3",
        "@babylonjs/gui": "^8.55.3",
        "@babylonjs/inspector": "8.27.2",
        "@babylonjs/loaders": "^8.55.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^13.5.0",
        "cannon": "^0.6.2",
        "earcut": "^3.0.2",
        "react": "^19.1.1",
        "react-app-rewired": "^2.2.1",
        "react-babylonjs": "^3.2.5-beta.2",
        "react-dom": "^19.1.1",
        "react-scripts": "5.0.1",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "start": "cross-env PORT=5051 react-app-rewired start",
        "build": "cross-env GENERATE_SOURCEMAP=false react-app-rewired build",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "postinstall": "node scripts/check-lfs.js",
        "electron:start": "cross-env ELECTRON_DEV=0 electron .",
        "electron:dev": "concurrently -k \"cross-env PORT=5051 BROWSER=none npm start\" \"wait-on http://127.0.0.1:5051 && cross-env ELECTRON_DEV=1 electron .\"",
        "electron:build": "npm run build && cross-env ELECTRON_DEV=0 electron .",
        "electron:pack": "npm run build && electron-builder --dir",
        "electron:dist": "npm run build && electron-builder",
        "electron:dist:win": "npm run build && electron-builder --win",
        "electron:dist:linux": "npm run build && electron-builder --linux zip",
        "electron:dist:mac": "npm run build && electron-builder --mac",
        "verify:setup": "node scripts/check-lfs.js",
        "heap:count": "node scripts/count-heap-class.js"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "build": {
        "extends": null,
        "appId": "com.hackingcomplete.game",
        "productName": "HaсK [C]omplete",
        "executableName": "HackComplete",
        "directories": {
            "output": "release",
            "buildResources": "electron/resources"
        },
        "files": [
            "build/**/*",
            "electron/**/*.js",
            "package.json",
            "!node_modules/**/*"
        ],
        "extraMetadata": {
            "main": "electron/main.js"
        },
        "asar": true,
        "asarUnpack": [
            "build/sounds/**",
            "build/textures/**"
        ],
        "artifactName": "HackComplete-${version}-${os}-${arch}.${ext}",
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "artifactName": "HackComplete-${version}-win-setup.${ext}"
        },
        "portable": {
            "artifactName": "HackComplete-${version}-win-portable.${ext}"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.games",
            "artifactName": "HackComplete-${version}-mac-${arch}.${ext}",
            "identity": null
        },
        "linux": {
            "target": [
                "AppImage",
                "zip"
            ],
            "category": "Game",
            "artifactName": "HackComplete-${version}-linux-${arch}.${ext}"
        }
    },
    "devDependencies": {
        "@types/cannon": "^0.1.13",
        "@types/earcut": "^3.0.0",
        "@types/node": "^25.9.1",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3",
        "electron": "^43.5.1",
        "electron-builder": "^26.0.12",
        "wait-on": "^8.0.5"
    }
}
